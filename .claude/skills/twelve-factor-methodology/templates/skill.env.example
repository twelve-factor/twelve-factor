# Twelve-Factor Methodology Skill - Environment Configuration

# Bus Backend Selection
BUS_BACKEND=json  # Options: json | sqlite | redis | graph

# Redis Configuration (if using redis backend)
# REDIS_URL=redis://localhost:6379/0

# Neo4j Configuration (if using graph backend)
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=your_password_here

# Performance Settings
SKIP_HOOKS=0           # Set to 1 to skip hooks (faster development)
FAST=0                 # Set to 1 for fast mode (minimal checks)
AGENTS_MAX=4           # Maximum parallel agents

# Feature Flags
ENABLE_AUTO_DOCS=1     # Auto-update documentation
ENABLE_METRICS=1       # Emit metrics events
ENABLE_VALIDATION=1    # Validate schemas and configs

# Twelve-Factor Specific
COMPLIANCE_THRESHOLD=0.75  # Minimum compliance score (0.0-1.0)
AUDIT_DEPTH=full           # Options: quick | standard | full
REMEDIATION_MODE=safe      # Options: safe | aggressive

# Logging
LOG_LEVEL=INFO        # DEBUG | INFO | WARN | ERROR
LOG_FORMAT=json       # json | text
